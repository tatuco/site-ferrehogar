# Token de sistema o de usuario con permiso catalog_management.
# Para crear el catálogo también hace falta business_management.
# Para vincularlo a WhatsApp: whatsapp_business_management.
# No subas este archivo a git.
META_ACCESS_TOKEN=

# Versión de Graph API. items_batch está documentado hasta v25.0.
GRAPH_API_VERSION=v25.0

# ID del catálogo en Commerce Manager.
# Si lo dejas vacío y CREATE_CATALOG_IF_MISSING=true, el script lo crea.
META_CATALOG_ID=

# Creación opcional: POST /{business-id}/owned_product_catalogs
CREATE_CATALOG_IF_MISSING=false
META_BUSINESS_ID=
META_PAGE_ID=
CATALOG_NAME=Ferreteria

# Vincula el catálogo a la cuenta de WhatsApp Business.
# Solo puede haber un catálogo por jerarquía de WhatsApp.
# También puedes pasar --link al ejecutar el script.
WHATSAPP_BUSINESS_ACCOUNT_ID=
LINK_WHATSAPP_CATALOG=false

# Catálogo local generado por este proyecto.
CATALOG_PATH=build/catalogo.json

# ISO 4217. Los precios del catálogo están en dólares.
CURRENCY=USD

# El JSON marca preciosSinIVA=true. Con true se envía precio * (1 + IVA_RATE).
INCLUDE_IVA=false
IVA_RATE=0.16

# Meta exige un link http(s) por producto. Placeholders: {id} {codigo} {catalogo}
STORE_BASE_URL=https://ejemplo.com/producto/{id}

# Las imágenes del JSON son rutas relativas (img/...). Hace falta un prefijo público https.
IMAGE_BASE_URL=https://ejemplo.com/

# JPG o PNG, idealmente de 500x500 o más. Solo se usa si SKIP_WITHOUT_IMAGE=false.
PLACEHOLDER_IMAGE_URL=
SKIP_WITHOUT_IMAGE=true

# Si el producto no trae existencia: in stock | out of stock | available for order | discontinued
DEFAULT_AVAILABILITY=available for order
DEFAULT_CONDITION=new

# true conserva MAYÚSCULAS del catálogo. Meta recomienda no enviar texto todo en mayúsculas.
PRESERVE_CASE=false

# UPDATE con allow_upsert crea el producto si no existe y lo actualiza si ya está.
# CREATE exige todos los campos requeridos y falla si el id ya existe.
BATCH_METHOD=UPDATE
ALLOW_UPSERT=true

# Máximo oficial: 5000. Recomendado: menos de 3000. El cuerpo no puede pasar de 28 MB.
BATCH_SIZE=2000
BATCH_DELAY_MS=1000

# true valida el JSON y escribe el reporte sin llamar a Meta. También: --dry-run
DRY_RUN=false

# 0 = todos los productos. También: --limit 20
LIMIT=0

# Filtros opcionales por id de proveedor o de catálogo dentro del JSON.
FILTER_PROVEEDOR=
FILTER_CATALOGO=

POLL_INTERVAL_MS=5000
POLL_TIMEOUT_MS=600000
REPORT_PATH=build/meta-upload-report.json
